PostgreDatabase=postgres://example_user:example_password@localhost:5432/example_database
Frontend_URL=https://penalyze.jrmsu-tc.online
Backend_URL=https://penalyze-api.jrmsu-tc.online
PORT=3000
JWT_SECRET=secret-key-for-jwt-signing
User=superuser@localhost.local
Password=87654321
CORS_ORIGIN=http://localhost:5173,https://penalyze.jrmsu-tc.online
ATTENDANCE_REPOSITORY_URL=https://attendance-repo.jrmsu-tc.cloud
PENALYZE_INTEGRATION_KEY=replace-with-shared-secret

# Set to the exact number of trusted reverse proxies in front of the API.
# Keep at 0 if the API can be reached directly (prevents spoofed client IPs).
TRUST_PROXY_HOPS=0
# Optional: use a stable random secret distinct from JWT_SECRET for hashing
# throttling identifiers. Must be the same across server instances.
LOGIN_RATE_LIMIT_SECRET=replace-with-another-long-random-secret
